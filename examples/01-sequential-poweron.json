[
  {
    "id": "scene-power-on-demo",
    "type": "tab",
    "label": "示例1: 顺序上电+延时 (幕布→投影→大屏)",
    "disabled": false,
    "info": "演示：单场景中多个 TCP 指令按顺序 + 固定延时下发。\n特点：不需要一堆 delay 节点连线，全部收敛在 scene-steps 里。"
  },
  {
    "id": "inj-1",
    "type": "inject",
    "z": "scene-power-on-demo",
    "name": "触发场景",
    "props": [{ "p": "payload" }],
    "repeat": "",
    "crontab": "",
    "once": false,
    "onceDelay": 0.1,
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 140,
    "y": 140,
    "wires": [["sc-1"]]
  },
  {
    "id": "sc-1",
    "type": "scene-steps",
    "z": "scene-power-on-demo",
    "name": "演示馆上电",
    "failBehavior": "skip",
    "maxLoopLimit": 1000,
    "defaultStepTimeoutMs": 5000,
    "steps": [
      { "id": "s1", "type": "tcp_send", "label": "幕布下降",
        "config": { "host":"192.168.1.21","port":8000,"payload":"OUT 1,1\r\n","format":"string","expectResponse":false,"keepAlive":false,"connectTimeoutMs":3000 },
        "postDelayMs": 3000, "timeoutMs": 0, "failBehaviorOverride": "skip" },
      { "id": "s2", "type": "delay",
        "config": { "delayMs": 5000 },
        "label": "", "postDelayMs": 0, "timeoutMs": 0, "failBehaviorOverride": "" },
      { "id": "s3", "type": "tcp_send", "label": "投影机开机",
        "config": { "host":"192.168.1.22","port":4352,"payload":"\\x21\\x00\\x00\\x00\\x00\\x00\\x02PJON\\x0D","format":"hex","expectResponse":true,"readDelimiter":"\\x0D","readTimeoutMs":5000,"keepAlive":false,"connectTimeoutMs":5000 },
        "postDelayMs": 15000, "timeoutMs": 0, "failBehaviorOverride": "" },
      { "id": "s4", "type": "tcp_send", "label": "大屏切换HDMI2",
        "config": { "host":"192.168.1.23","port":5000,"payload":"SOURCE HDMI2\\r\\n","format":"string","expectResponse":false,"keepAlive":false,"connectTimeoutMs":3000 },
        "postDelayMs": 2000, "timeoutMs": 0, "failBehaviorOverride": "" },
      { "id": "s5", "type": "tcp_send", "label": "灯光全开",
        "config": { "host":"192.168.1.24","port":9000,"payload":"SET LIGHT 1-8 100\\r\\n","format":"string","expectResponse":false,"keepAlive":false,"connectTimeoutMs":3000 },
        "postDelayMs": 0, "timeoutMs": 0, "failBehaviorOverride": "" }
    ],
    "x": 380,
    "y": 140,
    "wires": [[], [], ["err-debug-1"], ["audit-debug-1"]]
  },
  {
    "id": "err-debug-1",
    "type": "debug",
    "z": "scene-power-on-demo",
    "name": "Error",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": true,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 660,
    "y": 180,
    "wires": []
  },
  {
    "id": "audit-debug-1",
    "type": "debug",
    "z": "scene-power-on-demo",
    "name": "Audit",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": true,
    "complete": "true",
    "targetType": "full",
    "statusVal": "",
    "statusType": "auto",
    "x": 660,
    "y": 220,
    "wires": []
  }
]
